#!/usr/bin/env mongosh

db.students.insertOne({ name: "John", age: 20, major: "Math" })
--------
db.students.insertMany([
  { name: "Sara", age: 22, major: "Physics" },
  { name: "Mike", age: 21, major: "Computer Science" }
])
-----------------------
printjson(db.students.find().toArray())
----------------------------
db.adminCommand({ listDatabases: 1 })
db.getCollectionNames()
----------------------
printjson(db.students.find({ age: { $gt: 20 } }).toArray())
--------------------------
printjson(db.students.find({ name: "Sara" }).toArray())
--------------------
printjson(db.students.find({}, { name: 1, major: 1, _id: 0 }).toArray())
-----------------------
db.students.updateOne(
  { name: "John" },
  { $set: { age: 21 } }
)
---------------------
db.students.updateMany(
  { age: { $lt: 22 } },
  { $set: { major: "Undeclared" } }
)
-----------------------
db.students.deleteOne({ name: "Mike" })
---------------
db.students.deleteMany({ age: { $lt: 21 } })
------------------
db.students.createIndex({ name: 1 })
-------------------
print(db.students.countDocuments())
-----------------
db.students.drop()
-----------------
db.dropDatabase()
---------------
db.employees.insertOne({
  name: "David",
  age: 30,
  department: { name: "HR", floor: 5 }
})
--------------------------------
printjson(db.employees.find({ "department.name": "HR" }).toArray())
-------------
db.employees.updateOne(
  { name: "David" },
  { $push: { skills: "Communication" } }
)
----------------------
printjson(db.employees.find({ skills: "Communication" }).toArray())
--------------------
db.employees.updateOne(
  { name: "David" },
  { $push: { skills: { $each: ["Leadership", "Recruitment"] } } }
)
------------------
db.employees.updateOne(
  { name: "David" },
  { $push: { hobbies: { $each: ["Reading", "Coding", "Gaming"] } } }
)
--------------------
db.employees.updateOne(
  { name: "David" },
  { $pull: { skills: "Recruitment" } }
)
--------------
db.employees.updateOne(
  { name: "David" },
  { $pull: { hobbies: "Reading" } }
)
-----------
